@model lab1.Models.Player
@{
    ViewData["Title"] = "Изменить имя";
}

<h2>Изменить имя игрока</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.PlayerId" />
    <p>Игрок: <b>@Model.Fname @Model.Sname</b> (@Model.PlayerId)</p>
    <div class="mb-2">
        <label>Новое имя:</label>
        <input type="text" name="newFname" value="@Model.Fname" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>