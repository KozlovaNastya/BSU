<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Protos\**" />
    <Compile Remove="Views\Player - Копировать\**" />
    <Content Remove="Protos\**" />
    <Content Remove="Views\Player - Копировать\**" />
    <EmbeddedResource Remove="Protos\**" />
    <EmbeddedResource Remove="Views\Player - Копировать\**" />
    <None Remove="Protos\**" />
    <None Remove="Views\Player - Копировать\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\player.proto" GrpcServices="Client" />
	</ItemGroup>
</Project>
